{
  "name": "@oboapp/source-triaditsa-org",
  "version": "0.2.0",
  "description": "Full-content RSS source for Sofia district Triaditsa",
  "license": "Unlicense",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "typesVersions": {
    "*": {
      "metadata": [
        "dist/cjs/metadata.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oboapp/sources.git",
    "directory": "packages/source-triaditsa-org"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./metadata": {
      "import": {
        "types": "./dist/esm/metadata.d.ts",
        "default": "./dist/esm/metadata.js"
      },
      "require": {
        "types": "./dist/cjs/metadata.d.ts",
        "default": "./dist/cjs/metadata.js"
      }
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/finalize-build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@oboapp/source-sdk": "0.1.1",
    "html-entities": "2.6.0",
    "turndown": "7.2.2"
  },
  "devDependencies": {
    "@types/turndown": "5.0.6"
  }
}
