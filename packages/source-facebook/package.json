{
  "name": "@oboapp/source-facebook",
  "version": "0.1.0",
  "description": "Configurable authorized Facebook Page source for Obo",
  "license": "Unlicense",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "typesVersions": {
    "*": {
      "metadata": [
        "dist/cjs/metadata.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oboapp/sources.git",
    "directory": "packages/source-facebook"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./metadata": {
      "import": {
        "types": "./dist/esm/metadata.d.ts",
        "default": "./dist/esm/metadata.js"
      },
      "require": {
        "types": "./dist/cjs/metadata.d.ts",
        "default": "./dist/cjs/metadata.js"
      }
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/finalize-build.mjs",
    "test": "tsc -p test/tsconfig.json && tsx --test test/*.test.ts",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=20.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@oboapp/source-sdk": "0.1.1"
  }
}
