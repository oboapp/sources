{
  "name": "@oboapp/source-web-utils",
  "version": "0.2.0",
  "description": "RSS and browser collection helpers for Obo data source packages",
  "main": "./dist/cjs/index.js",
  "scripts": {
    "test": "tsc -p test/tsconfig.json && tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/finalize-build.mjs",
    "prepack": "pnpm build"
  },
  "license": "Unlicense",
  "type": "module",
  "types": "./dist/cjs/index.d.ts",
  "engines": {
    "node": ">=20.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oboapp/sources.git",
    "directory": "packages/source-web-utils"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/esm/browser.d.ts",
        "default": "./dist/esm/browser.js"
      },
      "require": {
        "types": "./dist/cjs/browser.d.ts",
        "default": "./dist/cjs/browser.js"
      }
    },
    "./rss": {
      "import": {
        "types": "./dist/esm/rss.d.ts",
        "default": "./dist/esm/rss.js"
      },
      "require": {
        "types": "./dist/cjs/rss.d.ts",
        "default": "./dist/cjs/rss.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "browser": [
        "dist/cjs/browser.d.ts"
      ],
      "rss": [
        "dist/cjs/rss.d.ts"
      ]
    }
  },
  "dependencies": {
    "@oboapp/source-sdk": "0.1.1",
    "html-entities": "2.6.0",
    "playwright": "1.61.1",
    "turndown": "7.2.2"
  },
  "devDependencies": {
    "@types/turndown": "5.0.6",
    "happy-dom": "20.0.11"
  }
}
